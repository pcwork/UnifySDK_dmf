Template: uic-zigpc/serial_port
Type: string
Default: /dev/ttyUSB0
Description: The serial port where the Zigbee NCP is connected.
 (default: /dev/ttyUSB0)

Template: uic-zigpc/datastore_file
Type: string
Default: ${CPACK_PACKAGING_INSTALL_PREFIX}/var/lib/uic/zigpc.db
Description: The datastore file.
 (default: ${CPACK_PACKAGING_INSTALL_PREFIX}/var/lib/uic/zigpc.db)

Template: uic-zigpc/supported_clusters
Type: string
Default:
Description: Comma-separated ZigPC supported clusters.
 Leave empty for the minimal default set: Basic,OnOff.

