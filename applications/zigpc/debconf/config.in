#!/bin/sh -e

. /usr/share/debconf/confmodule

UIC_CONFDIR=${CPACK_PACKAGING_INSTALL_PREFIX}/etc/uic
UIC_CONFFILE=$UIC_CONFDIR/uic.cfg

if [ -e $UIC_CONFFILE ]; then
  while IFS= read line
  do
    case "$line" in
      "zigpc:" )
        state="zigpc"
        ;;
      " "* | "-"* )
        ;;
      *) state="" ;;
    esac
    case $state in
      "zigpc" )
        case "$line" in
        *"serial:"* | *"datastore_file:"* | *"supported_clusters:"*)
          echo "$line" ;;
        *)
          ;;
        esac ;;
      *)
        ;;
    esac
  done < "$UIC_CONFFILE" > "$UIC_CONFFILE.sh.tmp"

  sed -e 's/:/="/g;s/$/"/g;s/ //g;s/^-//g;/""/d;s/serial/zigpc_serial/g;s/datastore_file/zigpc_datastore_file/g;s/supported_clusters/zigpc_supported_clusters/g;' $UIC_CONFFILE.sh.tmp > $UIC_CONFFILE.sh

  echo "Existing config options"
  cat $UIC_CONFFILE.sh
  . $UIC_CONFFILE.sh || true
  rm $UIC_CONFFILE.sh $UIC_CONFFILE.sh.tmp

  if [ ! -z "$zigpc_serial" ]; then
    db_set uic-zigpc/serial_port "$zigpc_serial"
  fi
  if [ ! -z "$zigpc_datastore_file" ]; then
    db_set uic-zigpc/datastore_file "$zigpc_datastore_file"
  fi
  if [ ! -z "$zigpc_supported_clusters" ]; then
    db_set uic-zigpc/supported_clusters "$zigpc_supported_clusters"
  fi
fi

db_input critical uic-zigpc/serial_port || true
db_input critical uic-zigpc/datastore_file || true
db_input critical uic-zigpc/supported_clusters || true
db_go

