    {
        "id": "aed3ca74858bdc61",
        "type": "function",
        "z": "07e8cabfaac8836f",
        "name": "init_device_list",
        "func": "// 期望主题格式: ucl/by-unid/{unid}/ep{endpoint}/{cluster}/Attributes/{attribute}/Reported\nconst topicParts = msg.topic.split('/');\nif (topicParts.length < 7) return null;\n\nlet unid = topicParts[2];\nlet epPart = topicParts[3];\nlet endpoint = parseInt(epPart.replace('ep', ''));\nlet cluster = topicParts[4];\nlet attribute = topicParts[6];\nlet value = msg.payload?.value;\nif (value === undefined) return null;\n\nconst key = `${unid}|${endpoint}`;\nlet devices = global.get(\"devices\") || {};\nlet device = devices[key];\n\n// ❌ 不再自动创建新设备，直接忽略未知设备\nif (!device) {\n    node.warn(`未知设备 ${key}，忽略该上报`);\n    return null;  // 不处理，不更新UI\n}\n\n// 设备存在则更新状态\ndevice.online = true;\n\nif (cluster === \"OnOff\" && attribute === \"OnOff\") {\n    device.onoff = value === true || value === 1 || value === \"1\";\n} else if (cluster === \"Level\" && attribute === \"CurrentLevel\") {\n    device.level = Math.min(254, Math.max(0, Number(value) || 0));\n}\n\nglobal.set(\"devices\", devices);\n\n// 只返回更新后的设备列表刷新UI\nreturn {\n    payload: Object.values(devices),\n    topic: \"devices-update\"\n};",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 140,
