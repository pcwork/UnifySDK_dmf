    {
        "id": "c2a5bb9063f7b8f9",
        "type": "function",
        "z": "07e8cabfaac8836f",
        "name": "解析上报并更新状态",
        "func": "// 期望主题格式: ucl/by-unid/{unid}/ep{endpoint}/{cluster}/Attributes/{attribute}/Reported\n\nconst topicParts = msg.topic.split('/');\n// 索引: 2=unid, 3=ep0(需提取数字), 4=cluster, 6=attribute\nif (topicParts.length < 7) return null;\n\nlet unid = topicParts[2];\nlet epPart = topicParts[3];    // 如 \"ep0\"\nlet endpoint = parseInt(epPart.replace('ep',''));\nlet cluster = topicParts[4];\nlet attribute = topicParts[6];\nlet value = msg.payload?.value;\nif (value === undefined) return null;\n\nconst key = `${unid}|${endpoint}`;\nlet devices = global.get(\"devices\") || {};\nlet device = devices[key];\nlet bulbs = global.get(\"lightbulbs\") || [];\n\nif (!device) {\n    if (cluster === \"OnOff\" || cluster === \"Level\") {\n        // 自动发现未知设备\n        device = {\n            unid: unid,\n            endpoint: endpoint,\n            name: `设备 ${unid.slice(-4)} ep${endpoint}`,\n            onoff: false,\n            level: 0,\n            online: true,\n            type: \"light\"\n        };\n        devices[key] = device;\n        // 同时更新 lightbulbs 列表（可选）\n\n        if (!bulbs.find(b => b.unid === unid && b.endpoint === endpoint)) {\n            bulbs.push({ unid, endpoint, name: device.name });\n            global.set(\"lightbulbs\", bulbs);\n        }\n    }\n    else {\n        device = {\n            unid: unid,\n            endpoint: endpoint,\n            name: `设备 ${unid.slice(-4)} ep${endpoint}`,\n        };\n    }\n}\n\n// 收到任何有效 UCL 上报，更新为在线\ndevice.online = true;\n\n// 更新设备状态\nif (cluster === \"OnOff\" && attribute === \"OnOff\") {\n    device.onoff = value === true || value === 1 || value === \"1\";\n} else if (cluster === \"Level\" && attribute === \"CurrentLevel\") {\n    device.level = Math.min(254, Math.max(0, Number(value) || 0));\n}\n\nglobal.set(\"devices\", devices);\n\nnode.log(\"当前devices: \" + JSON.stringify(devices))\nnode.log(\"当前bulbs: \" + JSON.stringify(bulbs))\n\n// 发送到 ui-template 刷新界面\n//return { payload: devices, topic: \"devices-update\" };\nreturn { \n    payload: Object.values(devices), \n    topic: \"devices-update\" \n};",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
