    {
        "id": "5fdb1ef4393b4de5",
        "type": "function",
        "z": "07e8cabfaac8836f",
        "name": "解析NCP并更新设备",
        "func": "// 处理 NCP NetworkManagement 消息\nconst topicParts = msg.topic.split('/');\n// 格式: ucl/by-unid/{unid}/ProtocolController/NetworkManagement\nif (topicParts.length < 4) return null;\nlet unid = topicParts[2];\n\n// 检查是否存在该设备\nlet devices = global.get(\"devices\") || {};\n// 使用 unid 和 endpoint=0 作为 key（假定NCP endpoint为0）\nconst key = `${unid}|0`;\nlet device = devices[key];\n\nif (!device) {\n    // 创建 NCP 设备\n    device = {\n        unid: unid,\n        endpoint: 0,\n        name: `NCP Dongle ${unid.slice(-6)}`,\n        online: true,\n        type: 'ncp' // 标记为NCP\n    };\n    devices[key] = device;\n} else {\n    // 更新在线状态\n    device.type = 'ncp'\n    name: `NCP Dongle ${unid.slice(-6)}`\n    device.online = true;\n\n    // 存储状态信息\n    if (msg.payload && msg.payload.State) {\n        device.ncpState = msg.payload.State;\n    }\n}\n\nglobal.set(\"devices\", devices);\n\n// 发送更新到UI\nreturn {\n    payload: Object.values(devices),\n    topic: \"devices-update\"\n};",
