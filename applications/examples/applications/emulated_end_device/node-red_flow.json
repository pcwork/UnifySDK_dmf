    {
        "id": "9baf9a4c257cee7e",
        "type": "function",
        "z": "07e8cabfaac8836f",
        "name": "处理UI控制指令",
        "func": "// 接收来自 ui-template 的控制指令\n// 格式：{ action: \"toggle\" 或 \"move\" 或 \"ncp\", unid, endpoint, value }\nconst cmd = msg.payload;\nif (!cmd || !cmd.action) return null;\n\nconst { action, unid, endpoint, value } = cmd;\nconst key = `${unid}|${endpoint}`;\nconst devices = global.get(\"devices\") || {};\nconst device = devices[key];\nif (!device) return null;\n\nlet mqttMsg = {\n    topic: \"\",\n    payload: {},\n    qos: 2\n};\n\nif (action === \"toggle\") {\n    // 发送 Toggle 命令（兼容原设备）\n    if (device.onoff){\n        mqttMsg.topic = `ucl/by-unid/${unid}/ep${endpoint}/OnOff/Commands/Off`;\n    }\n    else{\n        mqttMsg.topic = `ucl/by-unid/${unid}/ep${endpoint}/OnOff/Commands/On`;\n    }\n    mqttMsg.payload = {};  // 某些设备需要 {\"onoff\": !device.onoff}，可按需调整\n    // 乐观更新\n    device.onoff = !device.onoff;\n} else if (action === \"move\") {\n    // 发送亮度调节命令\n    mqttMsg.topic = `ucl/by-unid/${unid}/ep${endpoint}/Level/Commands/MoveToLevelWithOnOff`;\n    mqttMsg.payload = {\n        Level: Math.min(254, Math.max(0, Number(value))),\n        TransitionTime: 100,\n        OptionsMask: 0,\n        OptionsOverride: 0\n    };\n    device.level = Number(value);\n} else if (action === \"ncp\") {\n    // 切换 NCP 状态\n    const currentState = device.ncpState || 'idle';\n    const newState = (currentState === 'idle') ? 'add node' : 'idle';\n    device.ncpState = newState;\n    mqttMsg.topic = `ucl/by-unid/${unid}/ProtocolController/NetworkManagement/Write`;\n    mqttMsg.payload = { State: newState };\n} else {\n    return null;\n}\n\n// 如果 mqttMsg.topic 为空，则不发送 MQTT（理论上不会）\nif (!mqttMsg.topic) return null;\n\n// 更新全局设备状态\nglobal.set(\"devices\", devices);\n\n// 组装用于回刷 UI 的设备数组\nlet uiUpdateMsg = {\n    payload: Object.values(devices),\n    topic: \"devices-update\"\n};\n\n// 输出 1 回传给 UI，输出 2 去 MQTT\nreturn [uiUpdateMsg, mqttMsg];",
